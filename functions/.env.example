# Comma-separated Firebase Authentication account emails allowed to use the POS.
# Leave empty to allow every authenticated, Email-verified account.
POS_ALLOWED_EMAILS=owner@example.com,staff@example.com

# Production requires App Check. Its registered public site key is in
# public/js/runtime-config.js. The emulator disables enforcement automatically.
# false is an explicit, temporary rollout/rollback override only.
ENFORCE_APP_CHECK=true
